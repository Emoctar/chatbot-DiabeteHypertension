# Fichier d'environnement pour la configuration de l'application

# Clé API Google (obligatoire)
GOOGLE_API_KEY="Votre_cle_API_Google"

# Modèle Gemini à utiliser (optionnel - par défaut: gemini-1.5-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Clé API OpenAI (optionnelle - si vous souhaitez utiliser OpenAI)
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Informations d'identification pour l'envoi d'e-mails
# EMAIL_HOST_USER=ton_adresse_email
# EMAIL_HOST_PASSWORD=mot_de_passe_application  # mot de passe d'application généré avec votre compte Google

# # Adresse e-mail par défaut pour l'envoi
# DEFAULT_FROM_EMAIL=ton_adresse_email
